#: includes/class-hspsc-admin.php:1723
#, php-format
msgid "%d URL warmed."
msgid_plural "%d URLs warmed."
msgstr[0] "Подготовлен %d URL."
msgstr[1] "Подготовлено %d URL."
msgstr[2] "Подготовлено %d URL."

#: includes/class-hspsc-admin.php:1776
msgid "Page Cache"
msgstr "Кеш страниц"

#: includes/class-hspsc-admin.php:1779
msgid "Cache full HTML pages for visitors."
msgstr "Кеширование полного HTML-кода страниц для посетителей."

#: includes/class-hspsc-admin.php:1780
msgid "Enable page caching for anonymous visitors"
msgstr "Включить кеширование страниц для неавторизованных посетителей"

#: includes/class-hspsc-admin.php:1784
msgid "Cache TTL (seconds)"
msgstr "TTL кеша (секунды)"

#: includes/class-hspsc-admin.php:1785
msgid "How long a page stays cached before regeneration."
msgstr "Время хранения страницы в кеше до повторного создания."

#: includes/class-hspsc-admin.php:1789
msgid "Excluded page paths"
msgstr "Исключённые пути страниц"

#: includes/class-hspsc-admin.php:1793
msgid ""
"One exact URL path per line, starting with /. Include the installation "
"subdirectory and translated paths when needed. Queries and trailing slashes "
"do not affect matching. Subpages, full URLs, and wildcards are not included. "
"Asset optimizations remain enabled."
msgstr ""
"Указывайте по одному точному пути URL в строке, начиная с /. При "
"необходимости включайте подкаталог установки и переведённые пути. Параметры "
"запроса и завершающие косые черты не влияют на сопоставление. Подстраницы, "
"полные URL и подстановочные знаки не поддерживаются. Оптимизация ресурсов "
"остаётся включённой."

#: includes/class-hspsc-admin.php:1796
msgid "Enable only if logged-in users see cache-safe content."
msgstr ""
"Включайте только в том случае, если содержимое для авторизованных "
"пользователей можно безопасно кешировать."

#: includes/class-hspsc-admin.php:1797
msgid "Allow page caching for logged-in users"
msgstr "Разрешить кеширование страниц для авторизованных пользователей"

#: includes/class-hspsc-admin.php:1800
msgid ""
"Warning: Can serve private data if enabled on sites with personalized "
"content."
msgstr ""
"Предупреждение: на сайтах с персонализированным содержимым этот параметр "
"может привести к раскрытию личных данных."

#: includes/class-hspsc-admin.php:1803
msgid "Apply frontend optimizations for logged-in users."
msgstr ""
"Применять оптимизацию внешней части сайта для авторизованных пользователей."

#: includes/class-hspsc-admin.php:1804
msgid "Allow frontend optimizations for logged-in users"
msgstr ""
"Разрешить оптимизацию внешней части сайта для авторизованных пользователей"

#: includes/class-hspsc-admin.php:1807
msgid ""
"Recommended off for editors/builders. Controls minify, script defer/async, "
"and frontend performance tweaks."
msgstr ""
"Рекомендуется отключить при работе в редакторах и конструкторах. Управляет "
"минификацией, атрибутами defer/async для скриптов и другими оптимизациями "
"внешней части сайта."

#: includes/class-hspsc-admin.php:1812
msgid "Robots.txt"
msgstr "Robots.txt"

#: includes/class-hspsc-admin.php:1815
msgid "Add disallow rules for known AI crawlers."
msgstr "Добавление запрещающих правил для известных поисковых роботов ИИ."

#: includes/class-hspsc-admin.php:1816
msgid "Disallow common AI crawlers"
msgstr "Запретить доступ распространённым роботам ИИ"

#: includes/class-hspsc-admin.php:1819
msgid "Adds rules via WordPress robots.txt output (no file write)."
msgstr ""
"Добавляет правила в robots.txt, выводимый WordPress, без записи в файл."

#: includes/class-hspsc-admin.php:1824
msgid "Browser Cache Headers"
msgstr "Заголовки кеширования браузера"

#: includes/class-hspsc-admin.php:1827
msgid "Send Cache-Control and ETag headers for cached pages."
msgstr "Отправка заголовков Cache-Control и ETag для кешированных страниц."

#: includes/class-hspsc-admin.php:1828
msgid "Send Cache-Control headers for cacheable pages"
msgstr ""
"Отправлять заголовки Cache-Control для страниц, доступных для кеширования"

#: includes/class-hspsc-admin.php:1832
msgid "HTML cache TTL (seconds)"
msgstr "TTL кеша HTML (секунды)"

#: includes/class-hspsc-admin.php:1833
msgid "Browser cache lifetime for HTML pages."
msgstr "Срок хранения HTML-страниц в кеше браузера."

#: includes/class-hspsc-admin.php:1838
msgid "Asset cache TTL (seconds)"
msgstr "TTL кеша ресурсов (секунды)"

#: includes/class-hspsc-admin.php:1839
msgid "Browser cache lifetime for static assets."
msgstr "Срок хранения статических ресурсов в кеше браузера."

#: includes/class-hspsc-admin.php:1845
msgid "Static Asset Caching"
msgstr "Кеширование статических ресурсов"

#: includes/class-hspsc-admin.php:1848
msgid "Cache generated CSS/JS for longer and revalidate other static files."
msgstr ""
"Более длительное кеширование созданных CSS/JS и повторная проверка "
"актуальности остальных статических файлов."

#: includes/class-hspsc-admin.php:1849
msgid "Enable safe browser cache rules for static assets"
msgstr ""
"Включить безопасные правила кеширования статических ресурсов в браузере"

#: includes/class-hspsc-admin.php:1853
msgid "Generated CSS/JS TTL (seconds)"
msgstr "TTL созданных CSS/JS (секунды)"

#: includes/class-hspsc-admin.php:1854
msgid "Cache lifetime for HSP-generated CSS/JS via web server rules."
msgstr ""
"Срок хранения созданных HSP файлов CSS/JS в кеше, задаваемый правилами веб-"
"сервера."

#: includes/class-hspsc-admin.php:1859
msgid "Add immutable only to HSP-generated CSS/JS."
msgstr "Добавлять immutable только к созданным HSP файлам CSS/JS."

#: includes/class-hspsc-admin.php:1860
msgid "Add immutable to generated CSS/JS"
msgstr "Добавлять immutable к созданным CSS/JS"

#: includes/class-hspsc-admin.php:1865
msgid "Automatically update .htaccess if writable."
msgstr "Автоматически обновлять .htaccess, если он доступен для записи."

#: includes/class-hspsc-admin.php:1866
msgid "Auto-write .htaccess rules when possible"
msgstr "Автоматически записывать правила .htaccess, когда это возможно"

#: includes/class-hspsc-admin.php:1870
msgid ""
"Warning: Incorrect .htaccess rules can break site access. Use with care."
msgstr ""
"Предупреждение: неправильные правила .htaccess могут сделать сайт "
"недоступным. Используйте с осторожностью."

#: includes/class-hspsc-admin.php:1874
msgid "Enable gzip/deflate compression via web server rules."
msgstr "Включить сжатие gzip/deflate с помощью правил веб-сервера."

#: includes/class-hspsc-admin.php:1875
msgid "Enable gzip/deflate compression"
msgstr "Включить сжатие gzip/deflate"

#: includes/class-hspsc-admin.php:1879
msgid ""
"Warning: If your server already manages compression, double-compression can "
"cause issues."
msgstr ""
"Предупреждение: если сжатие уже настроено на сервере, повторное сжатие может "
"вызвать проблемы."

#: includes/class-hspsc-admin.php:1882
msgid "Apache .htaccess snippet"
msgstr "Фрагмент .htaccess для Apache"

#: includes/class-hspsc-admin.php:1897
msgid "Render Blocking Optimization"
msgstr "Оптимизация ресурсов, блокирующих отрисовку"

#: includes/class-hspsc-admin.php:1900
msgid "Add defer to scripts to reduce render blocking."
msgstr "Добавлять defer к скриптам, чтобы уменьшить блокировку отрисовки."

#: includes/class-hspsc-admin.php:1901
msgid "Add defer to enqueued scripts"
msgstr "Добавлять defer к скриптам, поставленным в очередь"

#: includes/class-hspsc-admin.php:1904
msgid ""
"Warning: Deferring scripts may break plugins that expect blocking execution."
msgstr ""
"Предупреждение: отложенное выполнение скриптов может нарушить работу "
"плагинов, которым требуется блокирующее выполнение."

#: includes/class-hspsc-admin.php:1908
msgid "Defer exclusions (script handles, one per line)"
msgstr "Исключения defer (идентификаторы скриптов, по одному в строке)"

#: includes/class-hspsc-admin.php:1909
msgid "Script handles that must not be deferred."
msgstr "Идентификаторы скриптов, выполнение которых нельзя откладывать."

#: includes/class-hspsc-admin.php:1913
msgid "Use async when defer is disabled."
msgstr "Использовать async, когда defer отключён."

#: includes/class-hspsc-admin.php:1914
msgid "Add async to enqueued scripts (if defer is off)"
msgstr ""
"Добавлять async к скриптам, поставленным в очередь (если defer отключён)"

#: includes/class-hspsc-admin.php:1917
msgid "Warning: Async can change execution order and break dependencies."
msgstr ""
"Предупреждение: async может изменить порядок выполнения и нарушить "
"зависимости."

#: includes/class-hspsc-admin.php:1921
msgid "Async exclusions (script handles, one per line)"
msgstr "Исключения async (идентификаторы скриптов, по одному в строке)"

#: includes/class-hspsc-admin.php:1922
msgid "Script handles that must not be async."
msgstr "Идентификаторы скриптов, которые нельзя выполнять асинхронно."

#: includes/class-hspsc-admin.php:1927
msgid "Preconnect URLs (one per line)"
msgstr "URL для предварительного подключения (по одному в строке)"

#: includes/class-hspsc-admin.php:1928
msgid "Origins to preconnect for faster TLS/handshake."
msgstr ""
"Источники для предварительного подключения, ускоряющего согласование TLS и "
"установку соединения."

#: includes/class-hspsc-admin.php:1933
msgid "Preload font URLs (one per line)"
msgstr "URL шрифтов для предварительной загрузки (по одному в строке)"

#: includes/class-hspsc-admin.php:1934
msgid "Font files to preload early."
msgstr "Файлы шрифтов, которые нужно загрузить заранее."

#: includes/class-hspsc-admin.php:1939
msgid "Preload CSS URLs (one per line)"
msgstr "URL CSS для предварительной загрузки (по одному в строке)"

#: includes/class-hspsc-admin.php:1940
msgid "Stylesheets to preload before render."
msgstr "Таблицы стилей, которые нужно загрузить до отрисовки."

#: includes/class-hspsc-admin.php:1945
msgid "Inline critical CSS"
msgstr "Встроенный критический CSS"

#: includes/class-hspsc-admin.php:1946
msgid "CSS injected inline to speed up first render."
msgstr ""
"CSS, добавляемый непосредственно в HTML для ускорения первой отрисовки."

#: includes/class-hspsc-admin.php:1952
msgid "Additional Performance"
msgstr "Дополнительные оптимизации"

#: includes/class-hspsc-admin.php:1955
msgid "Adds loading=\"lazy\" to images where safe."
msgstr "Добавляет loading=\"lazy\" к изображениям, когда это безопасно."

#: includes/class-hspsc-admin.php:1956
msgid "Enable native lazy-loading for images"
msgstr "Включить встроенную в браузер отложенную загрузку изображений"

#: includes/class-hspsc-admin.php:1959
msgid "Adds loading=\"lazy\" to iframes where safe."
msgstr "Добавляет loading=\"lazy\" к iframe, когда это безопасно."

#: includes/class-hspsc-admin.php:1960
msgid "Enable native lazy-loading for iframes"
msgstr "Включить встроенную в браузер отложенную загрузку iframe"

#: includes/class-hspsc-admin.php:1963
msgid "Hints browser to decode images asynchronously."
msgstr "Рекомендует браузеру декодировать изображения асинхронно."

#: includes/class-hspsc-admin.php:1964
msgid "Add decoding=\"async\" to images"
msgstr "Добавлять decoding=\"async\" к изображениям"

#: includes/class-hspsc-admin.php:1967
msgid "Remove emoji scripts and styles for faster loads."
msgstr "Удалять скрипты и стили эмодзи для ускорения загрузки."

#: includes/class-hspsc-admin.php:1968
msgid "Disable emoji scripts and styles"
msgstr "Отключить скрипты и стили эмодзи"

#: includes/class-hspsc-admin.php:1971
msgid "Disable oEmbed discovery and scripts."
msgstr "Отключить обнаружение oEmbed и соответствующие скрипты."

#: includes/class-hspsc-admin.php:1972
msgid "Disable WordPress embeds"
msgstr "Отключить встраивание WordPress"

#: includes/class-hspsc-admin.php:1975
msgid "Remove Dashicons for non-logged-in visitors."
msgstr "Убирать Dashicons для неавторизованных посетителей."

#: includes/class-hspsc-admin.php:1976
msgid "Disable Dashicons for guests"
msgstr "Отключить Dashicons для гостей"

#: includes/class-hspsc-admin.php:1979
msgid ""
"Warning: Disabling embeds or Dashicons can affect themes or plugins that rely"
" on them."
msgstr ""
"Предупреждение: отключение встраивания или Dashicons может повлиять на темы и"
" плагины, которые их используют."

#: includes/class-hspsc-admin.php:1983
msgid "DNS prefetch URLs (one per line)"
msgstr "URL для предварительного разрешения DNS (по одному в строке)"

#: includes/class-hspsc-admin.php:1984
msgid "Hostnames to DNS-prefetch."
msgstr "Имена хостов для предварительного разрешения DNS."

#: includes/class-hspsc-admin.php:1990
msgid "Cache Preload"
msgstr "Предварительная загрузка кеша"

#: includes/class-hspsc-admin.php:1993
msgid "Allow manual preload of URLs from sitemap."
msgstr "Разрешить ручную предварительную загрузку URL из карты сайта."

#: includes/class-hspsc-admin.php:1994
msgid "Enable cache preloading"
msgstr "Включить предварительную загрузку кеша"

#: includes/class-hspsc-admin.php:1998
msgid "Sitemap URL"
msgstr "URL карты сайта"

#: includes/class-hspsc-admin.php:1999
msgid "Sitemap to pull URLs from for warming."
msgstr "Карта сайта, из которой берутся URL для подготовки кеша."

#: includes/class-hspsc-admin.php:2004
msgid "Max URLs to warm"
msgstr "Максимум URL для подготовки"

#: includes/class-hspsc-admin.php:2005
msgid "Limit number of URLs warmed per run."
msgstr "Ограничение количества URL, подготавливаемых за один запуск."

#: includes/class-hspsc-admin.php:2010
msgid "Request timeout (seconds)"
msgstr "Время ожидания запроса (секунды)"

#: includes/class-hspsc-admin.php:2011
msgid "Timeout per warmed URL."
msgstr "Время ожидания для каждого подготавливаемого URL."

#: includes/class-hspsc-admin.php:2017
msgid "Minification"
msgstr "Минификация"

#: includes/class-hspsc-admin.php:2020
msgid "Remove whitespace/comments from HTML."
msgstr "Удалять пробельные символы и комментарии из HTML."

#: includes/class-hspsc-admin.php:2021
msgid "Minify HTML"
msgstr "Минифицировать HTML"

#: includes/class-hspsc-admin.php:2024
msgid "Create minified CSS files in the cache."
msgstr "Создавать минифицированные файлы CSS в кеше."

#: includes/class-hspsc-admin.php:2025
msgid "Minify CSS files"
msgstr "Минифицировать файлы CSS"

#: includes/class-hspsc-admin.php:2028
msgid "Create minified JS files in the cache."
msgstr "Создавать минифицированные файлы JS в кеше."

#: includes/class-hspsc-admin.php:2029
msgid "Minify JS files"
msgstr "Минифицировать файлы JS"

#: includes/class-hspsc-admin.php:2034
msgid "Object Cache"
msgstr "Объектный кеш"

#: includes/class-hspsc-admin.php:2037
msgid "Use file-based persistent object cache drop-in."
msgstr ""
"Использовать постоянный файловый объектный кеш через расширение drop-in."

#: includes/class-hspsc-admin.php:2038
msgid "Enable file-based persistent object cache (drop-in)"
msgstr "Включить постоянный файловый объектный кеш (drop-in)"

#: includes/class-hspsc-admin.php:2042
msgid "Default TTL for uncached entries (seconds)"
msgstr "TTL по умолчанию для некешированных записей (секунды)"

#: includes/class-hspsc-admin.php:2043
msgid "Used when an object cache write does not provide an expiration."
msgstr "Используется, если при записи в объектный кеш не указан срок действия."

#: includes/class-hspsc-admin.php:2048
msgid "Maximum TTL cap (seconds)"
msgstr "Максимальный TTL (секунды)"

#: includes/class-hspsc-admin.php:2049
msgid ""
"Caps any longer object cache expiration and bounds legacy unlimited entries."
msgstr ""
"Ограничивает более длительные сроки действия объектного кеша и устанавливает "
"предел для старых записей без срока действия."

#: includes/class-hspsc-admin.php:2053
msgid ""
"Warning: Object cache drop-ins can conflict with other cache plugins. Entries"
" without an expiration are now capped by the maximum TTL and periodically "
"cleaned up."
msgstr ""
"Предупреждение: расширения drop-in объектного кеша могут конфликтовать с "
"другими плагинами кеширования. Записи без срока действия теперь ограничены "
"максимальным TTL и периодически удаляются."

#: includes/class-hspsc-admin.php:2058
msgid "CDN"
msgstr "CDN"

#: includes/class-hspsc-admin.php:2061
msgid "Rewrite static asset URLs to your CDN."
msgstr "Замена URL статических ресурсов адресами вашей CDN."

#: includes/class-hspsc-admin.php:2062
msgid "Enable CDN URL rewriting for static assets"
msgstr "Включить замену URL статических ресурсов адресами CDN"

#: includes/class-hspsc-admin.php:2066
msgid "CDN Base URL"
msgstr "Базовый URL CDN"

#: includes/class-hspsc-admin.php:2067
msgid "Base URL used for CDN rewriting."
msgstr "Базовый URL, используемый для замены адресов CDN."

#: includes/class-hspsc-admin.php:2074
msgid "Saving..."
msgstr "Сохранение…"

#: includes/class-hspsc-admin.php:2074
msgid "Save Changes"
msgstr "Сохранить изменения"

#: includes/class-hspsc-admin.php:2083
msgid "Cache Operations"
msgstr "Операции с кешем"

#: includes/class-hspsc-admin.php:2084
msgid "Run routine cache tasks without leaving this screen."
msgstr "Выполняйте обычные операции с кешем прямо на этом экране."

#: includes/class-hspsc-admin.php:2087
msgid "Cache"
msgstr "Кеш"

#: includes/class-hspsc-admin.php:2092
msgid "Clearing..."
msgstr "Очистка…"

#: includes/class-hspsc-admin.php:2092
msgid "Clear All Caches"
msgstr "Очистить все кеши"

#: includes/class-hspsc-admin.php:2097
msgid "Testing..."
msgstr "Проверка…"

#: includes/class-hspsc-admin.php:2097
msgid "Run Cache Tests"
msgstr "Запустить проверки кеша"

#: includes/class-hspsc-admin.php:2106
msgid "Preload"
msgstr "Предварительная загрузка"

#: includes/class-hspsc-admin.php:2110
msgid "Preloading..."
msgstr "Предварительная загрузка…"

#: includes/class-hspsc-admin.php:2110
msgid "Run Cache Preload"
msgstr "Запустить предварительную загрузку кеша"

#: includes/class-hspsc-admin.php:2116
msgid ""
"Apply the Bricks compatibility preset? This disables overlapping HSP Smart "
"Cache optimizations so Bricks can own them."
msgstr ""
"Применить набор настроек совместимости с Bricks? Он отключит дублирующие "
"оптимизации HSP Smart Cache, чтобы ими управлял Bricks."

#: includes/class-hspsc-admin.php:2119
msgid "Applying..."
msgstr "Применение…"

#: includes/class-hspsc-admin.php:2119
msgid "Apply Bricks Preset"
msgstr "Применить настройки для Bricks"

#: includes/class-hspsc-admin.php:2125
msgid ""
"Bricks detected. This preset turns off duplicate HSP lazy-load, emoji/embed "
"cleanup, and script defer/async."
msgstr ""
"Обнаружен Bricks. Этот набор отключает дублирующие функции HSP: отложенную "
"загрузку, удаление эмодзи и встраиваний, а также defer/async для скриптов."

#: includes/class-hspsc-admin.php:2126
msgid ""
"Use this on Bricks sites to let Bricks handle its native performance toggles."
msgstr ""
"Используйте этот набор на сайтах с Bricks, чтобы Bricks управлял собственными"
" настройками производительности."

#: includes/class-hspsc-admin.php:2130
msgid "Restore all plugin settings to defaults?"
msgstr "Восстановить настройки по умолчанию для всего плагина?"

#: includes/class-hspsc-admin.php:2133
msgid "Restore Defaults"
msgstr "Восстановить настройки по умолчанию"

#: includes/class-hspsc-admin.php:2139
msgid "Database Maintenance"
msgstr "Обслуживание базы данных"

#: includes/class-hspsc-admin.php:2140
msgid ""
"Inspect, clean, optimize, and manage generated backups from one workspace."
msgstr ""
"Проверка, очистка, оптимизация и управление созданными резервными копиями на "
"одном экране."

#: includes/class-hspsc-admin.php:2146
msgid "Analyzing..."
msgstr "Анализ…"

#: includes/class-hspsc-admin.php:2146
msgid "Analyze"
msgstr "Анализировать"

#: includes/class-hspsc-admin.php:2148
msgid "Run database cleanup now?"
msgstr "Запустить очистку базы данных сейчас?"

#: includes/class-hspsc-admin.php:2151
msgid "Cleaning..."
msgstr "Очистка…"

#: includes/class-hspsc-admin.php:2151
msgid "Clean Database"
msgstr "Очистить базу данных"

#: includes/class-hspsc-admin.php:2156
msgid "Creating..."
msgstr "Создание…"

#: includes/class-hspsc-admin.php:2156
msgid "Create Backup"
msgstr "Создать резервную копию"

#: includes/class-hspsc-admin.php:2158
msgid "Create a backup and optimize database tables now?"
msgstr "Создать резервную копию и оптимизировать таблицы базы данных сейчас?"

#: includes/class-hspsc-admin.php:2161
