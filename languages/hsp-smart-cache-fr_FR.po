msgstr "Avertissement : %s"

#: includes/class-hspsc-admin.php:1080
msgid "Database backup restore failed. No diagnostic details were returned."
msgstr ""
"La restauration de la sauvegarde de la base de données a échoué. Aucun détail"
" de diagnostic n’a été renvoyé."

#: includes/class-hspsc-admin.php:1085
msgid ""
"The selected backup file was not found or did not match the allowed backup "
"filename format."
msgstr ""
"Le fichier de sauvegarde sélectionné est introuvable ou son nom ne respecte "
"pas le format autorisé."

#: includes/class-hspsc-admin.php:1086
msgid "The backup file could not be read or decompressed."
msgstr "Le fichier de sauvegarde n’a pas pu être lu ou décompressé."

#: includes/class-hspsc-admin.php:1087
msgid "The backup file did not contain executable SQL statements."
msgstr ""
"Le fichier de sauvegarde ne contenait aucune instruction SQL exécutable."

#: includes/class-hspsc-admin.php:1088
msgid ""
"This backup has no integrity signature. Create a new backup with this version"
" before restoring."
msgstr ""
"Cette sauvegarde ne possède pas de signature d’intégrité. Créez une nouvelle "
"sauvegarde avec cette version avant de procéder à une restauration."

#: includes/class-hspsc-admin.php:1089
msgid ""
"Backup integrity verification failed. The file, site, or signing keys have "
"changed."
msgstr ""
"La vérification de l’intégrité de la sauvegarde a échoué. Le fichier, le site"
" ou les clés de signature ont changé."

#: includes/class-hspsc-admin.php:1090
msgid "The backup contains unsupported SQL. No statements were executed."
msgstr ""
"La sauvegarde contient des instructions SQL non prises en charge. Aucune "
"instruction n’a été exécutée."

#: includes/class-hspsc-admin.php:1091
msgid "The backup must be a regular file in this site's backup directory."
msgstr ""
"La sauvegarde doit être un fichier ordinaire situé dans le répertoire de "
"sauvegarde de ce site."

#: includes/class-hspsc-admin.php:1092
msgid "A database query failed while replaying the backup."
msgstr ""
"Une requête de base de données a échoué lors de la restauration de la "
"sauvegarde."

#: includes/class-hspsc-admin.php:1093
msgid ""
"No WordPress tables were restored. The backup may use a different table "
"prefix than this site."
msgstr ""
"Aucune table WordPress n’a été restaurée. La sauvegarde utilise peut-être un "
"préfixe de table différent de celui de ce site."

#: includes/class-hspsc-admin.php:1096
msgid "Unknown restore failure."
msgstr "Échec de restauration inconnu."

