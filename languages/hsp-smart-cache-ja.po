msgid "HSP Smart Cache"
msgstr "HSP Smart Cache"

#. Description of the plugin
#: hsp-smart-cache.php
msgid ""
"Page caching, minification, CDN rewriting, and file-based object cache with "
"settings UI."
msgstr "設定画面を備えた、ページキャッシュ、圧縮、CDN URL の書き換え、ファイルベースのオブジェクトキャッシュ。"

#. Author of the plugin
#: hsp-smart-cache.php
msgid "Helmut Steiner"
msgstr "Helmut Steiner"

