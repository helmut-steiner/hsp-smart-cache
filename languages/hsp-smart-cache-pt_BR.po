msgid "HSP Smart Cache"
msgstr "HSP Smart Cache"

#. Description of the plugin
#: hsp-smart-cache.php
msgid ""
"Page caching, minification, CDN rewriting, and file-based object cache with "
"settings UI."
msgstr ""
"Cache de páginas, minificação, reescrita de CDN e cache de objetos baseado em"
" arquivos com interface de configurações."

#. Author of the plugin
#: hsp-smart-cache.php
msgid "Helmut Steiner"
msgstr "Helmut Steiner"

