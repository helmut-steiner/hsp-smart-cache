msgid "Database analysis completed."
msgstr "Zakończono analizę bazy danych."

#: includes/class-hspsc-admin.php:853 includes/class-hspsc-admin.php:1731
msgid "Database cleanup failed. Some queries did not complete."
msgstr ""
"Czyszczenie bazy danych nie powiodło się. Niektóre zapytania nie zostały "
"wykonane."

#: includes/class-hspsc-admin.php:860 includes/class-hspsc-admin.php:1728
msgid "Database cleanup completed."
msgstr "Zakończono czyszczenie bazy danych."

#: includes/class-hspsc-admin.php:876
msgid "Database backup failed."
msgstr "Utworzenie kopii zapasowej bazy danych nie powiodło się."

