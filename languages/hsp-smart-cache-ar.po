msgstr "مجلد النسخ الاحتياطية قابل للكتابة: %s"

#: includes/class-hspsc-admin.php:1306 includes/class-hspsc-admin.php:1314
msgid "yes"
msgstr "نعم"

#: includes/class-hspsc-admin.php:1306 includes/class-hspsc-admin.php:1314
msgid "no"
msgstr "لا"

#. translators: %s is yes or no.
#: includes/class-hspsc-admin.php:1313
#, php-format
msgid "File writable: %s"
msgstr "الملف قابل للكتابة: %s"

