#. Plugin Name of the plugin
#: hsp-smart-cache.php includes/class-hspsc-admin.php:136
#: includes/class-hspsc-admin.php:137 includes/class-hspsc-admin.php:1708
msgid "HSP Smart Cache"
msgstr "HSP Smart Cache"

#. Description of the plugin
#: hsp-smart-cache.php
msgid ""
"Page caching, minification, CDN rewriting, and file-based object cache with "
"settings UI."
msgstr ""
"Caché de páginas, minimización, reescritura de CDN y caché de objetos basada "
"en archivos con interfaz de ajustes."

#. Author of the plugin
#: hsp-smart-cache.php
msgid "Helmut Steiner"
msgstr "Helmut Steiner"

