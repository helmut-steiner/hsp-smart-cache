#. Description of the plugin
#: hsp-smart-cache.php
msgid ""
"Page caching, minification, CDN rewriting, and file-based object cache with "
"settings UI."
msgstr "提供设置界面的页面缓存、代码压缩、CDN URL 重写和基于文件的对象缓存。"

#. Author of the plugin
#: hsp-smart-cache.php
msgid "Helmut Steiner"
msgstr "Helmut Steiner"

