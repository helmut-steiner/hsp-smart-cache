#: includes/class-hspsc-admin.php:823
#, php-format
msgid "Preload completed. %d URL warmed."
msgid_plural "Preload completed. %d URLs warmed."
msgstr[0] "اكتمل التحميل المسبق. لم يُجهّز أي رابط (%d)."
msgstr[1] "اكتمل التحميل المسبق. جُهّز رابط واحد (%d)."
msgstr[2] "اكتمل التحميل المسبق. جُهّز رابطان (%d)."
msgstr[3] "اكتمل التحميل المسبق. جُهّزت %d روابط."
msgstr[4] "اكتمل التحميل المسبق. جُهّز %d رابطًا."
msgstr[5] "اكتمل التحميل المسبق. جُهّز %d رابط."

#: includes/class-hspsc-admin.php:840 includes/class-hspsc-admin.php:1740
msgid "Database analysis completed."
msgstr "اكتمل تحليل قاعدة البيانات."

#: includes/class-hspsc-admin.php:853 includes/class-hspsc-admin.php:1731
msgid "Database cleanup failed. Some queries did not complete."
msgstr "تعذّر تنظيف قاعدة البيانات. لم تكتمل بعض الاستعلامات."

#: includes/class-hspsc-admin.php:860 includes/class-hspsc-admin.php:1728
msgid "Database cleanup completed."
msgstr "اكتمل تنظيف قاعدة البيانات."

#: includes/class-hspsc-admin.php:876
msgid "Database backup failed."
msgstr "تعذّر إنشاء نسخة احتياطية لقاعدة البيانات."

#: includes/class-hspsc-admin.php:882 includes/class-hspsc-admin.php:1746
msgid "Database backup created."
msgstr "أُنشئت نسخة احتياطية لقاعدة البيانات."

#: includes/class-hspsc-admin.php:898 includes/class-hspsc-admin.php:1743
msgid "Database backup failed. Optimization was not executed."
msgstr "تعذّر إنشاء نسخة احتياطية لقاعدة البيانات. لم يُنفّذ التحسين."

#: includes/class-hspsc-admin.php:905 includes/class-hspsc-admin.php:1737
msgid "Database optimization failed. Some tables were not optimized."
msgstr "تعذّر تحسين قاعدة البيانات. لم تُحسّن بعض الجداول."

#: includes/class-hspsc-admin.php:912 includes/class-hspsc-admin.php:1734
msgid "Database optimization completed."
msgstr "اكتمل تحسين قاعدة البيانات."

#: includes/class-hspsc-admin.php:962 includes/class-hspsc-admin.php:1761
msgid "Database backup deleted."
msgstr "حُذفت النسخة الاحتياطية لقاعدة البيانات."

#: includes/class-hspsc-admin.php:976 includes/class-hspsc-admin.php:1570
msgid "Unauthorized"
msgstr "غير مصرّح لك"

#: includes/class-hspsc-admin.php:980
msgid "Security check failed. Refresh the page and try again."
msgstr "فشل التحقق الأمني. حدّث الصفحة وحاول مرة أخرى."

#: includes/class-hspsc-admin.php:1024
msgid "Database backup restored."
msgstr "استُعيدت قاعدة البيانات من النسخة الاحتياطية."

#. translators: 1: number of restored tables, 2: number of executed SQL
#. statements.
#: includes/class-hspsc-admin.php:1033
#, php-format
msgid ""
"Database backup restored with warnings. Tables: %1$d. SQL statements: %2$d."
msgstr ""
"استُعيدت قاعدة البيانات من النسخة الاحتياطية مع تحذيرات. الجداول: %1$d. "
"عبارات SQL: %2$d."

#. translators: 1: number of restored tables, 2: number of executed SQL
#. statements.
#: includes/class-hspsc-admin.php:1041
#, php-format
msgid "Database backup restored. Tables: %1$d. SQL statements: %2$d."
msgstr ""
"استُعيدت قاعدة البيانات من النسخة الاحتياطية. الجداول: %1$d. عبارات SQL: "
"%2$d."

#. translators: %s is a restore warning.
#: includes/class-hspsc-admin.php:1063 includes/class-hspsc-admin.php:1139
#, php-format
msgid "Warning: %s"
msgstr "تحذير: %s"

#: includes/class-hspsc-admin.php:1080
msgid "Database backup restore failed. No diagnostic details were returned."
msgstr ""
"تعذّرت استعادة قاعدة البيانات من النسخة الاحتياطية. لم تُرجع العملية أي "
"تفاصيل تشخيصية."

#: includes/class-hspsc-admin.php:1085
msgid ""
"The selected backup file was not found or did not match the allowed backup "
"filename format."
msgstr ""
"لم يُعثر على ملف النسخة الاحتياطية المحدد، أو أن اسمه لا يطابق التنسيق "
"المسموح به لأسماء ملفات النسخ الاحتياطية."

#: includes/class-hspsc-admin.php:1086
msgid "The backup file could not be read or decompressed."
msgstr "تعذّرت قراءة ملف النسخة الاحتياطية أو فك ضغطه."

#: includes/class-hspsc-admin.php:1087
msgid "The backup file did not contain executable SQL statements."
msgstr "لا يحتوي ملف النسخة الاحتياطية على عبارات SQL قابلة للتنفيذ."

#: includes/class-hspsc-admin.php:1088
msgid ""
"This backup has no integrity signature. Create a new backup with this version"
" before restoring."
msgstr ""
"لا تحتوي هذه النسخة الاحتياطية على توقيع للتحقق من سلامتها. أنشئ نسخة "
"احتياطية جديدة بهذا الإصدار قبل الاستعادة."

#: includes/class-hspsc-admin.php:1089
msgid ""
"Backup integrity verification failed. The file, site, or signing keys have "
"changed."
msgstr ""
"فشل التحقق من سلامة النسخة الاحتياطية. تغيّر الملف أو الموقع أو مفاتيح "
"التوقيع."

#: includes/class-hspsc-admin.php:1090
msgid "The backup contains unsupported SQL. No statements were executed."
msgstr "تحتوي النسخة الاحتياطية على عبارات SQL غير مدعومة. لم تُنفّذ أي عبارة."

#: includes/class-hspsc-admin.php:1091
msgid "The backup must be a regular file in this site's backup directory."
msgstr ""
"يجب أن تكون النسخة الاحتياطية ملفًا عاديًا داخل مجلد النسخ الاحتياطية لهذا "
"الموقع."

#: includes/class-hspsc-admin.php:1092
msgid "A database query failed while replaying the backup."
msgstr "فشل استعلام لقاعدة البيانات أثناء تنفيذ النسخة الاحتياطية."

#: includes/class-hspsc-admin.php:1093
msgid ""
"No WordPress tables were restored. The backup may use a different table "
"prefix than this site."
msgstr ""
"لم تُستعد أي جداول WordPress. قد تستخدم النسخة الاحتياطية بادئة جداول تختلف "
"عن بادئة هذا الموقع."

#: includes/class-hspsc-admin.php:1096
msgid "Unknown restore failure."
msgstr "خطأ غير معروف أثناء الاستعادة."

#. translators: 1: internal diagnostic code, 2: human-readable diagnostic
#. detail.
#: includes/class-hspsc-admin.php:1100
#, php-format
msgid "Database backup restore failed. Code: %1$s. %2$s"
msgstr "تعذّرت استعادة قاعدة البيانات من النسخة الاحتياطية. الرمز: %1$s. %2$s"

#. translators: %d is the failed SQL statement number.
#: includes/class-hspsc-admin.php:1122
#, php-format
msgid "Failed statement number: %d"
msgstr "رقم العبارة التي فشلت: %d"

#. translators: %s is a shortened SQL statement.
#: includes/class-hspsc-admin.php:1130
#, php-format
msgid "Failed SQL: %s"
msgstr "عبارة SQL التي فشلت: %s"

#. translators: %s is a backup file name.
#: includes/class-hspsc-admin.php:1163 includes/class-hspsc-admin.php:1265
#, php-format
msgid "File: %s"
msgstr "الملف: %s"

#. translators: %s is an absolute filesystem path.
#: includes/class-hspsc-admin.php:1171 includes/class-hspsc-admin.php:1273
#, php-format
msgid "Path: %s"
msgstr "المسار: %s"

#. translators: 1: executed statements, 2: total parsed statements, 3: skipped
#. statements.
#: includes/class-hspsc-admin.php:1178
#, php-format
msgid "SQL statements: %1$d executed, %2$d parsed, %3$d skipped."
msgstr "عبارات SQL: نُفّذت %1$d، وحُلّلت %2$d، وتُخطّيت %3$d."

#. translators: 1: table name, 2: drop count, 3: create count, 4: insert count.
#: includes/class-hspsc-admin.php:1188
#, php-format
msgid "Table %1$s: DROP=%2$d CREATE=%3$d INSERT=%4$d."
msgstr "الجدول %1$s: DROP=%2$d CREATE=%3$d INSERT=%4$d."

#. translators: 1: skip reason, 2: SQL preview.
#: includes/class-hspsc-admin.php:1204
#, php-format
msgid "Skipped SQL (%1$s): %2$s"
msgstr "عبارة SQL التي تُخطّيت (%1$s): %2$s"

#: includes/class-hspsc-admin.php:1240
msgid "Deleting database backup failed. No diagnostic details were returned."
msgstr ""
"تعذّر حذف النسخة الاحتياطية لقاعدة البيانات. لم تُرجع العملية أي تفاصيل "
"تشخيصية."

#: includes/class-hspsc-admin.php:1245
msgid ""
"The posted backup filename did not match the allowed backup filename format."
msgstr ""
"اسم ملف النسخة الاحتياطية المُرسل لا يطابق التنسيق المسموح به لأسماء ملفات "
"النسخ الاحتياطية."

#: includes/class-hspsc-admin.php:1246
msgid "The backup file was not found at the expected path."
msgstr "لم يُعثر على ملف النسخة الاحتياطية في المسار المتوقع."

#: includes/class-hspsc-admin.php:1247
msgid "The resolved backup path is outside the configured backup directory."
msgstr ""
"مسار النسخة الاحتياطية بعد تحديده يقع خارج مجلد النسخ الاحتياطية المضبوط."

#: includes/class-hspsc-admin.php:1248
msgid ""
"WordPress filesystem deletion, wp_delete_file(), and unlink() did not remove "
"the file."
msgstr ""
"لم يُحذف الملف باستخدام نظام ملفات WordPress أو الدالتين wp_delete_file() "
"وunlink()."

#: includes/class-hspsc-admin.php:1251
msgid "Unknown backup deletion failure."
msgstr "خطأ غير معروف أثناء حذف النسخة الاحتياطية."

#: includes/class-hspsc-admin.php:1253
msgid "Deleting database backup failed."
msgstr "تعذّر حذف النسخة الاحتياطية لقاعدة البيانات."

#. translators: %s is an internal diagnostic code.
#: includes/class-hspsc-admin.php:1256
#, php-format
