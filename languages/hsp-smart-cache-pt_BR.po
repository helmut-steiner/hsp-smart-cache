msgstr ""
"O arquivo de backup selecionado não foi encontrado ou seu nome não "
"corresponde ao formato permitido."

#: includes/class-hspsc-admin.php:1086
msgid "The backup file could not be read or decompressed."
msgstr "Não foi possível ler ou descompactar o arquivo de backup."

