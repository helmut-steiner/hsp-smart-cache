<?xml version="1.0"?>
<ruleset name="HSP Smart Cache">
	<description>WordPress Coding Standards for shipped PHP runtime code.</description>
	<file>hsp-smart-cache.php</file>
	<file>uninstall.php</file>
	<file>includes</file>
	<file>dropins</file>
	<arg name="extensions" value="php" />
	<arg value="s" />
	<config name="minimum_wp_version" value="7.1.3" />
	<rule ref="WordPress" />
	<!-- WordPress discovers these entry points by their required public filenames. -->
	<rule ref="WordPress.Files.FileName.InvalidClassFileName">
		<exclude-pattern>*/hsp-smart-cache.php</exclude-pattern>
		<exclude-pattern>*/dropins/object-cache.php</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="hsp-smart-cache" />
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="HSPSC" />
				<element value="hspsc" />
			</property>
		</properties>
	</rule>
</ruleset>
